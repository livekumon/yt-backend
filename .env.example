# MongoDB (Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/youtube-downloader

# Auth — use a long random string in production
JWT_SECRET=change-me-in-production

# CORS — comma-separated origins (Tauri dev + web + production)
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost

# PayPal (USD — US / worldwide)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | production
PAYPAL_MODE=sandbox

# Razorpay (INR — India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: USD→INR for converting pack prices to paise (default 84)
RAZORPAY_USD_TO_INR=84

# Optional single-product fallback (same semantics as placetowebsite "go_live")
PAYPAL_GO_LIVE_AMOUNT_USD=5
PAYPAL_GO_LIVE_PUBLISHING_CREDITS=1

# Where the app runs (Tauri dev or hosted). Used in PayPal return/cancel URLs.
FRONTEND_URL=http://localhost:1420
